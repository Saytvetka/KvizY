# Образец настроек BiletY. НЕ клади сюда настоящие значения и не коммить файл .env.
# В Yandex Cloud всё это задаётся в переменных ревизии контейнера (через GitHub Secrets, см. docs/yandex_cloud.md).

# Пароль для входа — ХЭШ. Сделать: python scripts/hash_password.py
BILETY_PASSWORD_HASH=
# Только для запуска на своём компьютере можно вместо хэша задать пароль открытым текстом:
# BILETY_PASSWORD=
# Секрет подписи cookie (длинная случайная строка)
SESSION_SECRET=
# Секрет шифрования ключей ИИ в базе (длинная случайная строка, НЕ меняй после сохранения ключей)
KEY_SECRET=

# Какой ИИ по умолчанию: yandex | gigachat | claude | openai | mock (меняется и в Настройках приложения)
AI_PROVIDER=yandex

# YandexGPT (+ распознавание фото Yandex Vision тем же ключом)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# Запасные провайдеры (для сравнения; ключ можно вписать и в Настройках приложения)
GIGACHAT_AUTH_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# База. Пусто = локальный файл SQLite (data/bilety.db). Для YDB — YDB_ENDPOINT и YDB_DATABASE.
DATABASE_URL=

# Бюджет в месяц, ₽ (для показа расходов)
MONTHLY_BUDGET_RUB=500
